# 🎨 Styles par ordonnanceur
scheduler_colors = {
    "rr": "cornflowerblue",
    "blest": "red",
    "ecf": "gold"
}

# 🎨 Hachures par algorithme de congestion
cc_hatch = {
    "balia": "++",
    "olia": "oo",
    "lia": "xx"
}

# 🔢 Préparation des données
items = list(data.items())
items.sort()  # Optionnel : trie les noms de fichiers

labels = []
durations = []
colors = []
hatches = []

for filename, duration in items:
    labels.append(filename.replace(".csv", ""))
    durations.append(duration)

    parts = filename.split("_")
    scheduler = parts[1]
    cc_algo = parts[2].replace(".csv", "").replace("_3", "")

    colors.append(scheduler_colors.get(scheduler, "gray"))
    hatches.append(cc_hatch.get(cc_algo, ""))

# 📊 Création de la figure
plt.figure(figsize=(12, 10), dpi=300)
#bars = plt.barh(labels, durations, color=colors)
bars = plt.barh(labels, durations, color=colors)
# 🧩 Appliquer les hachures
for bar, hatch in zip(bars, hatches):
    bar.set_hatch(hatch)

plt.xlabel("Temps de téléchargement (s)", fontsize=12)
plt.title("(c)", fontsize=20)
#plt.xticks(rotation=90,fontsize=15)
plt.xticks(fontsize=15)
plt.yticks(fontsize=15)

